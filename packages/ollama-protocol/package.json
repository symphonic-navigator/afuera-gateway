{
  "name": "@afuera/ollama-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wire-compatible TypeScript port of the ollama-uplink tunnel protocol (frame codec, session crypto, TunnelSession multiplexer). See docs/specs/ollama-relay.md.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
